{
  "manifest_version": 3,
  "name": "Postit Tareas",
  "version": "0.1.0",
  "description": "Post-its pegados a tus pestañas y tus tareas del día a un clic.",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Postit Tareas" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "tabs", "contextMenus", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "new-note": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Nuevo post-it en esta pestaña"
    }
  }
}
